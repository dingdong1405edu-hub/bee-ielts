generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  LEARNER
  ADMIN
}

enum CEFRLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum Skill {
  READING
  LISTENING
  WRITING
  SPEAKING
  VOCAB
  GRAMMAR
}

enum TestBank {
  PRACTICE
  MOCK
}

enum QuestionType {
  MCQ
  FILL_BLANK
  TRUE_FALSE
  TRUE_FALSE_NOT_GIVEN
  MATCHING
  MATCHING_HEADINGS
  MATCHING_INFO
  MATCHING_FEATURES
  MATCHING_SENTENCE_ENDINGS
  SHORT_ANSWER
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String?
  passwordHash       String?
  role               Role      @default(LEARNER)
  xp                 Int       @default(0)
  hearts             Int       @default(5)
  streakDays         Int       @default(0)
  lastActiveAt       DateTime?
  targetBand         Float     @default(6.0)
  examDate           DateTime?
  // Placement band — last overallBand from a /mock/test attempt. Used by
  // /band-climber to recommend the right stage (4→5, 5→6, …). Null until
  // the learner completes their first mock.
  placementBand      Float?
  placementDoneAt    DateTime?
  popQuizOn          Boolean   @default(false)
  streakRestoresUsed Int       @default(0)
  streakRestoreMonth String?
  avatarUrl          String?   @db.Text
  coverUrl           String?   @db.Text
  bio                String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  vocabProgress   VocabProgress[]
  grammarProgress GrammarProgress[]
  attempts        Attempt[]
  posts           Post[]
  postLikes       PostLike[]
  postComments    PostComment[]
  readingComments ReadingComment[]
  wordDecks       WordDeck[]
  studyPlan       StudyPlanEntry[]
  payments        Payment[]
  mockAttempts    MockAttempt[]
}

/// One row per completed mock test. Stores enough data to render the
/// per-skill review page later — the underlying tests can change without
/// breaking history. JSON columns hold a snapshot of each skill so the
/// review page can render answers + explanations + AI feedback.
model MockAttempt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())
  overallBand Float
  summary     String   @db.Text

  listeningBand    Float
  listeningCorrect Int
  listeningTotal   Int
  listeningPayload Json

  readingBand    Float
  readingCorrect Int
  readingTotal   Int
  readingPayload Json

  writingBand     Float
  writingPayload  Json

  speakingBand    Float
  speakingPayload Json

  @@index([userId, completedAt])
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
  FAILED
}

/// A "band climber" stage: a curated lesson admins write to help learners
/// move from one IELTS band to the next (e.g. 4.0 → 5.0). Each stage holds
/// markdown content for all four skills; users tap a stage and read the
/// per-skill tips. Listening stays empty for now per the product spec —
/// admin can fill it in later without a migration.
model BandStage {
  id          String   @id @default(cuid())
  fromBand    Float
  toBand      Float
  title       String
  subtitle    String?
  description String?  @db.Text
  order       Int      @default(0)
  reading     String   @default("") @db.Text
  listening   String   @default("") @db.Text
  writing     String   @default("") @db.Text
  speaking    String   @default("") @db.Text
  // Whether the HƯỚNG DẪN drawer (admin-authored markdown tips) is shown
  // to learners when they open: a long test (path-view hero button), and
  // a mini-quiz (player top-bar button). Admin can toggle either, both,
  // or neither — defaults to both on so existing stages keep their
  // current behavior.
  tipsShowOnTest     Boolean  @default(true)
  tipsShowOnMiniQuiz Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  readingTests   ReadingTest[]
  listeningTests ListeningTest[]
  writingTasks   WritingTask[]
  speakingSets   SpeakingSet[]
  miniQuizzes    BandClimbMiniQuiz[]

  @@unique([fromBand, toBand])
}

// Duolingo-style short quizzes inside a band-climb stage. Each holds a list
// of small image/text-choice questions; learners walk through them one by
// one with a progress bar and a green/red feedback bar (luyennoi/duolingo
// pattern). Skill: which of the 4 IELTS skills this mini-quiz belongs to.
model BandClimbMiniQuiz {
  id          String   @id @default(cuid())
  bandStageId String
  bandStage   BandStage @relation(fields: [bandStageId], references: [id], onDelete: Cascade)
  skill       Skill    // READING | LISTENING | WRITING | SPEAKING
  title       String
  order       Int      @default(0)
  // Admin-authored Bee 🐝 tour steps shown before the quiz starts — same
  // JSON shape as ReadingTest.bandClimbTips (TourStep[]). Null/empty =
  // no bee overlay, quiz starts immediately.
  bandClimbTips Json?
  // Optional vocab pack the learner can preview before the quiz starts and
  // (one tap) import as a brand-new flashcard deck. JSON array shape:
  //   [{ term, definition, example? }]
  // Null / empty = no pre-quiz vocab screen is shown.
  vocabPack   Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  questions   MiniQuestion[]

  @@index([bandStageId, skill])
}

// Single short question inside a BandClimbMiniQuiz. `type` decides how the
// options are rendered: IMAGE_CHOICE = 3-4 picture cards (each option has
// optional imageUrl + label), TEXT_CHOICE = list of text answers.
// `options` is JSON: [{ label: string, imageUrl?: string }, ...]
// `correctIndex` is the 0-based index of the right option.
model MiniQuestion {
  id           String   @id @default(cuid())
  miniQuizId   String
  miniQuiz     BandClimbMiniQuiz @relation(fields: [miniQuizId], references: [id], onDelete: Cascade)
  type         String   // "IMAGE_CHOICE" | "TEXT_CHOICE"
  prompt       String   @db.Text
  // Optional audio URL the player surfaces with a play button above the
  // prompt — useful for Listening-style mini-quizzes where admin wants the
  // learner to hear a sentence before answering.
  audioUrl     String?  @db.Text
  options      Json     // [{ label, imageUrl? }, ...]
  correctIndex Int
  order        Int      @default(0)
  // Admin-authored explanation shown to the learner after they check the
  // question — surfaces WHY the correct option is right (and why the
  // distractors are wrong). Rendered in the verdict bar of the mini-quiz
  // player for both correct and wrong outcomes. Empty / null = no
  // explanation rendered.
  explanation  String?  @db.Text

  @@index([miniQuizId])
}

// PayOS order — one per attempted checkout. orderCode is the integer ID
// PayOS uses to identify the order across its webhook + return URL params.
model Payment {
  id          String        @id @default(cuid())
  orderCode   Int           @unique
  amount      Int
  description String        @db.Text
  status      PaymentStatus @default(PENDING)
  userId      String?
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  checkoutUrl String?       @db.Text
  paidAt      DateTime?
  rawWebhook  Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}

// User-created Quizlet-style vocabulary decks.
model WordDeck {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  cards     WordCard[]
  createdAt DateTime   @default(now())

  @@index([userId])
}

model WordCard {
  id         String   @id @default(cuid())
  deckId     String
  deck       WordDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  term       String
  definition String   @db.Text
  example    String?  @db.Text
  mastered   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([deckId])
}

model Post {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String        @db.Text
  imageUrl  String?       @db.Text
  createdAt DateTime      @default(now())
  likes     PostLike[]
  comments  PostComment[]

  @@index([createdAt])
}

model PostLike {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model PostComment {
  id        String        @id @default(cuid())
  postId    String
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String        @db.Text
  createdAt DateTime      @default(now())
  parentId  String?
  parent    PostComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PostComment[] @relation("CommentReplies")

  @@index([postId])
  @@index([parentId])
}

model VocabUnit {
  id      String        @id @default(cuid())
  title   String
  level   CEFRLevel
  order   Int
  iconKey String?
  lessons VocabLesson[]

  @@unique([level, order])
}

model VocabLesson {
  id        String          @id @default(cuid())
  unitId    String
  unit      VocabUnit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title     String
  order     Int
  exercises Json
  progress  VocabProgress[]
}

model VocabProgress {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    VocabLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed Boolean     @default(false)
  score     Int?
  updatedAt DateTime    @updatedAt

  @@unique([userId, lessonId])
}

model GrammarUnit {
  id      String          @id @default(cuid())
  title   String
  level   CEFRLevel
  order   Int
  lessons GrammarLesson[]
}

model GrammarLesson {
  id        String            @id @default(cuid())
  unitId    String
  unit      GrammarUnit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title     String
  order     Int
  content   String            @db.Text
  exercises Json
  progress  GrammarProgress[]
}

model GrammarProgress {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    GrammarLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed Boolean       @default(false)
  score     Int?
  updatedAt DateTime      @updatedAt

  @@unique([userId, lessonId])
}

model ReadingTest {
  id        String           @id @default(cuid())
  title     String
  level     CEFRLevel        @default(B1)
  passage   String           @db.Text
  imageUrl  String?          @db.Text
  timeLimit Int              @default(1200)
  slot      String?
  bank      TestBank         @default(PRACTICE)
  // Optional link to a Vượt band stage — when set, the test is hidden from
  // the regular /reading list and appears as practice attached to a stage
  // (with the BeeGuide tour + tip-aware Groq explanations).
  bandStageId String?
  bandStage   BandStage?     @relation(fields: [bandStageId], references: [id], onDelete: SetNull)
  // Admin-authored Bee 🐝 tour steps shown before the test starts when
  // accessed through the Vượt band flow. JSON array of TourStep —
  // see src/components/learn/bee-guide.tsx for the shape. Null = use the
  // skill default tour from src/lib/band-climb-tours.ts.
  bandClimbTips Json?
  questions Question[]
  comments  ReadingComment[]
  createdAt DateTime         @default(now())

  @@index([bank])
  @@index([bandStageId])
}

model ReadingComment {
  id        String      @id @default(cuid())
  readingId String
  reading   ReadingTest @relation(fields: [readingId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String      @db.Text
  createdAt DateTime    @default(now())

  @@index([readingId])
}

model ListeningTest {
  id              String     @id @default(cuid())
  title           String
  audioUrl        String
  imageUrl        String?    @db.Text
  contentImageUrl String?    @db.Text
  transcript      String?    @db.Text
  timeLimit       Int        @default(1200)
  bank            TestBank   @default(PRACTICE)
  // IELTS section 1-4 — only used for MOCK tests so the runner can pick one per section.
  section         Int?
  // Optional Vượt band stage attachment (mirrors ReadingTest.bandStageId).
  bandStageId     String?
  bandStage       BandStage? @relation(fields: [bandStageId], references: [id], onDelete: SetNull)
  bandClimbTips   Json?
  questions       Question[]
  createdAt       DateTime   @default(now())

  @@index([bank])
  @@index([bandStageId])
}

model Question {
  id            String         @id @default(cuid())
  type          QuestionType
  prompt        String         @db.Text
  options       Json?
  correctAnswer Json
  explanation   String?        @db.Text
  order         Int            @default(0)
  // FILL_BLANK questions that share this key are one pasted form-completion
  // passage and render together as a single flowing block.
  formGroup     String?
  // Admin-set displayed question number — overrides auto-numbering shown to
  // the learner (e.g. force "Câu 16" so a Part-2 test continues IELTS numbering
  // from Part 1). Only honored in single-test practice; mock tests keep 1–N.
  displayNumber Int?
  readingId     String?
  reading       ReadingTest?   @relation(fields: [readingId], references: [id], onDelete: Cascade)
  listeningId   String?
  listening     ListeningTest? @relation(fields: [listeningId], references: [id], onDelete: Cascade)
}

model WritingTask {
  id            String     @id @default(cuid())
  taskType      Int
  prompt        String     @db.Text
  imageUrl      String?
  diagramSvg    String?    @db.Text
  minWords      Int        @default(150)
  timeLimit     Int        @default(1200)
  bandStageId   String?
  bandStage     BandStage? @relation(fields: [bandStageId], references: [id], onDelete: SetNull)
  bandClimbTips Json?
  createdAt     DateTime   @default(now())

  @@index([bandStageId])
}

model SpeakingSet {
  id             String     @id @default(cuid())
  topic          String
  imageUrl       String?    @db.Text
  part1Questions Json
  part2CueCard   Json
  part3Questions Json
  bandStageId    String?
  bandStage      BandStage? @relation(fields: [bandStageId], references: [id], onDelete: SetNull)
  bandClimbTips  Json?
  createdAt      DateTime   @default(now())

  @@index([bandStageId])
}

/// User study plan entries: manual notes/milestones plus auto-generated roadmap tasks.
model StudyPlanEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  title     String
  skill     Skill?
  note      String?  @db.Text
  done      Boolean  @default(false)
  auto      Boolean  @default(false) // true = part of an auto-generated roadmap
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

model Attempt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill       Skill
  refId       String
  rawAnswer   Json
  score       Float?
  feedback    Json?
  durationSec Int?
  createdAt   DateTime @default(now())

  @@index([userId, skill])
}

// Background music admin can attach to one or more learner sections
// (HOME, PROFILE, COMMUNITY, BAND_CLIMBER, VOCAB, GRAMMAR, READING,
// LISTENING, WRITING, SPEAKING, WORDS, MOCK). The client player auto-pauses
// the moment the user enters an actual exercise/test route so it doesn't
// fight the lesson audio. `audioUrl` should resolve to an mp3/ogg the
// browser can play directly (CDN, R2, etc.).
model BackgroundMusic {
  id        String   @id @default(cuid())
  name      String
  audioUrl  String   @db.Text
  scopes    String[]
  volume    Float    @default(0.4)
  enabled   Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, order])
}

// Audit log of admin content actions (create/update/delete). Snapshots
// entityTitle so the timeline still reads correctly even after the
// underlying bài/đề/quiz is deleted. userId is nullable because the
// referenced admin may be deleted later — we keep email + name snapshots
// so attribution survives.
model AdminActivity {
  id          String   @id @default(cuid())
  userId      String?
  userEmail   String
  userName    String?
  action      String   // "CREATE" | "UPDATE" | "DELETE"
  entityType  String   // "READING_TEST" | "LISTENING_TEST" | "WRITING_TASK" | "SPEAKING_SET" | "BAND_STAGE" | "MINI_QUIZ" | "VOCAB_UNIT" | "VOCAB_LESSON" | "GRAMMAR_UNIT" | "GRAMMAR_LESSON" | "BACKGROUND_MUSIC" | "SPEAKING_VOICE"
  entityId    String
  entityTitle String   @db.Text
  entityHref  String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, createdAt])
  @@index([userId, createdAt])
}

// Examiner voices the Speaking module offers learners. Admin can add/remove
// entries on /admin/voices so the catalogue isn't pinned to a hard-coded
// list. voiceId is the Deepgram Aura identifier (e.g. aura-2-aurora-en).
model SpeakingVoice {
  id        String   @id @default(cuid())
  voiceId   String   @unique
  name      String
  accent    String
  gender    String
  enabled   Boolean  @default(true)
  isDefault Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, order])
}
