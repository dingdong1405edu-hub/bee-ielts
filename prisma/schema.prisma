generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  LEARNER
  ADMIN
  OWNER
}

/// Status of a learner's request to be upgraded to premium. PENDING is
/// the queue an owner reviews; APPROVED/REJECTED is a record of the
/// decision (owner can revoke after approving by flipping the user's
/// isPremium flag — the request itself stays as a historical row).
enum PremiumRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// What a coupon redemption gives the learner. PREMIUM flips isPremium
/// to true; XP and HEARTS add a numeric reward to the User row.
enum CouponRewardKind {
  PREMIUM
  XP
  HEARTS
}

enum CEFRLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum Skill {
  READING
  LISTENING
  WRITING
  SPEAKING
  VOCAB
  GRAMMAR
}

enum TestBank {
  PRACTICE
  MOCK
}

enum QuestionType {
  MCQ
  FILL_BLANK
  TRUE_FALSE
  TRUE_FALSE_NOT_GIVEN
  MATCHING
  MATCHING_HEADINGS
  MATCHING_INFO
  MATCHING_FEATURES
  MATCHING_SENTENCE_ENDINGS
  SHORT_ANSWER
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String?
  passwordHash       String?
  role               Role      @default(LEARNER)
  xp                 Int       @default(0)
  hearts             Int       @default(5)
  streakDays         Int       @default(0)
  lastActiveAt       DateTime?
  targetBand         Float     @default(6.0)
  examDate           DateTime?
  // Placement band — last overallBand from a /mock/test attempt. Used by
  // /band-climber to recommend the right stage (4→5, 5→6, …). Null until
  // the learner completes their first mock.
  placementBand      Float?
  placementDoneAt    DateTime?
  popQuizOn          Boolean   @default(false)
  streakRestoresUsed Int       @default(0)
  streakRestoreMonth String?
  avatarUrl          String?   @db.Text
  coverUrl           String?   @db.Text
  bio                String?
  // Premium flag — OWNER + ADMIN are implicitly premium via effectivePremium();
  // this column carries the explicit grant for LEARNER role users so the
  // checker is a simple OR of (role in OWNER/ADMIN, isPremium=true).
  isPremium          Boolean   @default(false)
  premiumGrantedAt   DateTime?
  /// User id (OWNER) who flipped isPremium → true. Used in the admin UI
  /// to attribute who approved which user. Null on revoke.
  premiumGrantedBy   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  vocabProgress     VocabProgress[]
  grammarProgress   GrammarProgress[]
  attempts          Attempt[]
  posts             Post[]
  postLikes         PostLike[]
  postComments      PostComment[]
  readingComments   ReadingComment[]
  wordDecks         WordDeck[]
  studyPlan         StudyPlanEntry[]
  payments          Payment[]
  mockAttempts      MockAttempt[]
  bandStageProgress BandStageProgress[]
  premiumRequests   PremiumRequest[]
  couponRedemptions CouponRedemption[]
  shadowingLessons  ShadowingLesson[]
  shadowingAttempts ShadowingAttempt[]
  shadowingNotes    ShadowingNote[]
  hostedRouletteRooms SpeakingRouletteRoom[] @relation("RouletteHost")
  roulettePlayers   SpeakingRoulettePlayer[]
}

/// A learner asks the owner to upgrade their account to premium. One
/// learner can have multiple historical rows (rejected, then later
/// approved). The owner reviews PENDING rows on /admin/premium.
model PremiumRequest {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String?              @db.Text
  status    PremiumRequestStatus @default(PENDING)
  createdAt DateTime             @default(now())
  decidedAt DateTime?
  /// User id (OWNER) who approved/rejected this request.
  decidedBy String?

  @@index([userId])
  @@index([status, createdAt])
}

/// Admin-created redeemable code. Code is uppercase + globally unique.
/// `maxUses=null` means unlimited; `usedCount` is incremented per
/// redemption inside a transaction so concurrent redeems can't
/// overshoot. `expiresAt=null` = never expires.
model Coupon {
  id          String           @id @default(cuid())
  code        String           @unique
  description String?
  rewardKind  CouponRewardKind
  /// XP / hearts amount. Ignored for PREMIUM.
  rewardValue Int              @default(0)
  maxUses     Int?
  usedCount   Int              @default(0)
  active      Boolean          @default(true)
  expiresAt   DateTime?
  /// User id of the admin/owner who created the code.
  createdBy   String
  createdAt   DateTime         @default(now())

  redemptions CouponRedemption[]

  @@index([active, expiresAt])
}

/// One row per (couponId, userId) — guarantees a user can only redeem a
/// given coupon once. Stored for audit (which user got what + when).
model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  redeemedAt DateTime @default(now())

  @@unique([couponId, userId])
  @@index([userId])
}

/// One row per completed mock test. Stores enough data to render the
/// per-skill review page later — the underlying tests can change without
/// breaking history. JSON columns hold a snapshot of each skill so the
/// review page can render answers + explanations + AI feedback.
model MockAttempt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())
  overallBand Float
  summary     String   @db.Text

  listeningBand    Float
  listeningCorrect Int
  listeningTotal   Int
  listeningPayload Json

  readingBand    Float
  readingCorrect Int
  readingTotal   Int
  readingPayload Json

  writingBand     Float
  writingPayload  Json

  speakingBand    Float
  speakingPayload Json

  @@index([userId, completedAt])
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
  FAILED
}

/// A "band climber" stage: a curated lesson admins write to help learners
/// move from one IELTS band to the next (e.g. 4.0 → 5.0). Each stage holds
/// markdown content for all four skills; users tap a stage and read the
/// per-skill tips. Listening stays empty for now per the product spec —
/// admin can fill it in later without a migration.
model BandStage {
  id          String   @id @default(cuid())
  fromBand    Float
  toBand      Float
  title       String
  subtitle    String?
  description String?  @db.Text
  order       Int      @default(0)
  reading     String   @default("") @db.Text
  listening   String   @default("") @db.Text
  writing     String   @default("") @db.Text
  speaking    String   @default("") @db.Text
  // Whether the HƯỚNG DẪN drawer (admin-authored markdown tips) is shown
  // to learners when they open: a long test (path-view hero button), and
  // a mini-quiz (player top-bar button). Admin can toggle either, both,
  // or neither — defaults to both on so existing stages keep their
  // current behavior.
  tipsShowOnTest     Boolean  @default(true)
  tipsShowOnMiniQuiz Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  readingTests   ReadingTest[]
  listeningTests ListeningTest[]
  writingTasks   WritingTask[]
  speakingSets   SpeakingSet[]
  miniQuizzes    BandClimbMiniQuiz[]
  progress       BandStageProgress[]

  @@unique([fromBand, toBand])
}

// Per-user marker that a band-climb stage has been finished. Powers the
// "complete stage N before unlocking N+1" gate on /band-climber: a learner
// at band 2.0 has to walk through the 4→5 stage and tap "Đánh dấu hoàn
// thành" before the 5→6 stage unlocks. One row = one finished stage.
model BandStageProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bandStageId String
  bandStage   BandStage @relation(fields: [bandStageId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([userId, bandStageId])
  @@index([userId])
}

// Duolingo-style short quizzes inside a band-climb stage. Each holds a list
// of small image/text-choice questions; learners walk through them one by
// one with a progress bar and a green/red feedback bar (luyennoi/duolingo
// pattern). Skill: which of the 4 IELTS skills this mini-quiz belongs to.
model BandClimbMiniQuiz {
  id          String   @id @default(cuid())
  bandStageId String
  bandStage   BandStage @relation(fields: [bandStageId], references: [id], onDelete: Cascade)
  skill       Skill    // READING | LISTENING | WRITING | SPEAKING
  title       String
  order       Int      @default(0)
  // Admin-authored Bee 🐝 tour steps shown before the quiz starts — same
  // JSON shape as ReadingTest.bandClimbTips (TourStep[]). Null/empty =
  // no bee overlay, quiz starts immediately.
  bandClimbTips Json?
  // Optional vocab pack the learner can preview before the quiz starts and
  // (one tap) import as a brand-new flashcard deck. JSON array shape:
  //   [{ term, definition, example? }]
  // Null / empty = no pre-quiz vocab screen is shown.
  vocabPack   Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  questions   MiniQuestion[]

  @@index([bandStageId, skill])
}

// Single short question inside a BandClimbMiniQuiz. `type` decides how the
// options are rendered: IMAGE_CHOICE = 3-4 picture cards (each option has
// optional imageUrl + label), TEXT_CHOICE = list of text answers.
// `options` is JSON: [{ label: string, imageUrl?: string }, ...]
// `correctIndex` is the 0-based index of the right option.
model MiniQuestion {
  id           String   @id @default(cuid())
  miniQuizId   String
  miniQuiz     BandClimbMiniQuiz @relation(fields: [miniQuizId], references: [id], onDelete: Cascade)
  type         String   // "IMAGE_CHOICE" | "TEXT_CHOICE"
  prompt       String   @db.Text
  // Optional audio URL the player surfaces with a play button above the
  // prompt — useful for Listening-style mini-quizzes where admin wants the
  // learner to hear a sentence before answering.
  audioUrl     String?  @db.Text
  options      Json     // [{ label, imageUrl? }, ...]
  correctIndex Int
  order        Int      @default(0)
  // Admin-authored explanation shown to the learner after they check the
  // question — surfaces WHY the correct option is right (and why the
  // distractors are wrong). Rendered in the verdict bar of the mini-quiz
  // player for both correct and wrong outcomes. Empty / null = no
  // explanation rendered.
  explanation  String?  @db.Text

  // IELTS Speaking Part-2 cue card bullets. JSON array of strings:
  //   ["What it is", "Where it happened", "How you felt"]
  // Only meaningful for SPEAKING-type questions. When non-empty the player
  // runs the IELTS Part-2 flow (1 minute prep + 2 minute speak with auto
  // recording) instead of the plain "record an answer" flow. Empty / null
  // = regular Part-1/3 style question.
  cueCardPoints Json?

  @@index([miniQuizId])
}

// PayOS order — one per attempted checkout. orderCode is the integer ID
// PayOS uses to identify the order across its webhook + return URL params.
model Payment {
  id          String        @id @default(cuid())
  orderCode   Int           @unique
  amount      Int
  description String        @db.Text
  status      PaymentStatus @default(PENDING)
  userId      String?
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  checkoutUrl String?       @db.Text
  paidAt      DateTime?
  rawWebhook  Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}

// User-created Quizlet-style vocabulary decks.
model WordDeck {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  cards     WordCard[]
  createdAt DateTime   @default(now())

  @@index([userId])
}

model WordCard {
  id         String   @id @default(cuid())
  deckId     String
  deck       WordDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  term       String
  definition String   @db.Text
  example    String?  @db.Text
  mastered   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([deckId])
}

model Post {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String        @db.Text
  imageUrl  String?       @db.Text
  createdAt DateTime      @default(now())
  likes     PostLike[]
  comments  PostComment[]

  @@index([createdAt])
}

model PostLike {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model PostComment {
  id        String        @id @default(cuid())
  postId    String
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String        @db.Text
  createdAt DateTime      @default(now())
  parentId  String?
  parent    PostComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PostComment[] @relation("CommentReplies")

  @@index([postId])
  @@index([parentId])
}

model VocabUnit {
  id      String        @id @default(cuid())
  title   String
  level   CEFRLevel
  order   Int
  iconKey String?
  lessons VocabLesson[]

  @@unique([level, order])
}

model VocabLesson {
  id        String          @id @default(cuid())
  unitId    String
  unit      VocabUnit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title     String
  order     Int
  exercises Json
  progress  VocabProgress[]
}

model VocabProgress {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    VocabLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed Boolean     @default(false)
  score     Int?
  updatedAt DateTime    @updatedAt

  @@unique([userId, lessonId])
}

model GrammarUnit {
  id      String          @id @default(cuid())
  title   String
  level   CEFRLevel
  order   Int
  lessons GrammarLesson[]
}

model GrammarLesson {
  id        String            @id @default(cuid())
  unitId    String
  unit      GrammarUnit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title     String
  order     Int
  content   String            @db.Text
  exercises Json
  progress  GrammarProgress[]
}

model GrammarProgress {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    GrammarLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed Boolean       @default(false)
  score     Int?
  updatedAt DateTime      @updatedAt

  @@unique([userId, lessonId])
}

model ReadingTest {
  id        String           @id @default(cuid())
  title     String
  level     CEFRLevel        @default(B1)
  passage   String           @db.Text
  imageUrl  String?          @db.Text
  timeLimit Int              @default(1200)
  slot      String?
  bank      TestBank         @default(PRACTICE)
  // Optional link to a Vượt band stage — when set, the test is hidden from
  // the regular /reading list and appears as practice attached to a stage
  // (with the BeeGuide tour + tip-aware Groq explanations).
  bandStageId String?
  bandStage   BandStage?     @relation(fields: [bandStageId], references: [id], onDelete: SetNull)
  // Admin-authored Bee 🐝 tour steps shown before the test starts when
  // accessed through the Vượt band flow. JSON array of TourStep —
  // see src/components/learn/bee-guide.tsx for the shape. Null = use the
  // skill default tour from src/lib/band-climb-tours.ts.
  bandClimbTips Json?
  questions Question[]
  comments  ReadingComment[]
  createdAt DateTime         @default(now())

  @@index([bank])
  @@index([bandStageId])
}

model ReadingComment {
  id        String      @id @default(cuid())
  readingId String
  reading   ReadingTest @relation(fields: [readingId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String      @db.Text
  createdAt DateTime    @default(now())

  @@index([readingId])
}

model ListeningTest {
  id              String     @id @default(cuid())
  title           String
  audioUrl        String
  imageUrl        String?    @db.Text
  contentImageUrl String?    @db.Text
  transcript      String?    @db.Text
  timeLimit       Int        @default(1200)
  bank            TestBank   @default(PRACTICE)
  // IELTS section 1-4 — only used for MOCK tests so the runner can pick one per section.
  section         Int?
  // Optional Vượt band stage attachment (mirrors ReadingTest.bandStageId).
  bandStageId     String?
  bandStage       BandStage? @relation(fields: [bandStageId], references: [id], onDelete: SetNull)
  bandClimbTips   Json?
  questions       Question[]
  createdAt       DateTime   @default(now())

  @@index([bank])
  @@index([bandStageId])
}

model Question {
  id            String         @id @default(cuid())
  type          QuestionType
  prompt        String         @db.Text
  options       Json?
  correctAnswer Json
  explanation   String?        @db.Text
  order         Int            @default(0)
  // FILL_BLANK questions that share this key are one pasted form-completion
  // passage and render together as a single flowing block.
  formGroup     String?
  // Admin-set displayed question number — overrides auto-numbering shown to
  // the learner (e.g. force "Câu 16" so a Part-2 test continues IELTS numbering
  // from Part 1). Only honored in single-test practice; mock tests keep 1–N.
  displayNumber Int?
  readingId     String?
  reading       ReadingTest?   @relation(fields: [readingId], references: [id], onDelete: Cascade)
  listeningId   String?
  listening     ListeningTest? @relation(fields: [listeningId], references: [id], onDelete: Cascade)
}

model WritingTask {
  id            String     @id @default(cuid())
  taskType      Int
  prompt        String     @db.Text
  imageUrl      String?
  diagramSvg    String?    @db.Text
  minWords      Int        @default(150)
  timeLimit     Int        @default(1200)
  bandStageId   String?
  bandStage     BandStage? @relation(fields: [bandStageId], references: [id], onDelete: SetNull)
  bandClimbTips Json?
  createdAt     DateTime   @default(now())

  @@index([bandStageId])
}

model SpeakingSet {
  id             String     @id @default(cuid())
  topic          String
  imageUrl       String?    @db.Text
  part1Questions Json
  part2CueCard   Json
  part3Questions Json
  bandStageId    String?
  bandStage      BandStage? @relation(fields: [bandStageId], references: [id], onDelete: SetNull)
  bandClimbTips  Json?
  createdAt      DateTime   @default(now())

  @@index([bandStageId])
}

/// User study plan entries: manual notes/milestones plus auto-generated roadmap tasks.
model StudyPlanEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  title     String
  skill     Skill?
  note      String?  @db.Text
  done      Boolean  @default(false)
  auto      Boolean  @default(false) // true = part of an auto-generated roadmap
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

model Attempt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill       Skill
  refId       String
  rawAnswer   Json
  score       Float?
  feedback    Json?
  durationSec Int?
  createdAt   DateTime @default(now())

  @@index([userId, skill])
}

// Background music admin can attach to one or more learner sections
// (HOME, PROFILE, COMMUNITY, BAND_CLIMBER, VOCAB, GRAMMAR, READING,
// LISTENING, WRITING, SPEAKING, WORDS, MOCK). The client player auto-pauses
// the moment the user enters an actual exercise/test route so it doesn't
// fight the lesson audio. `audioUrl` should resolve to an mp3/ogg the
// browser can play directly (CDN, R2, etc.).
model BackgroundMusic {
  id        String   @id @default(cuid())
  name      String
  audioUrl  String   @db.Text
  scopes    String[]
  volume    Float    @default(0.4)
  enabled   Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, order])
}

// Audit log of admin content actions (create/update/delete). Snapshots
// entityTitle so the timeline still reads correctly even after the
// underlying bài/đề/quiz is deleted. userId is nullable because the
// referenced admin may be deleted later — we keep email + name snapshots
// so attribution survives.
model AdminActivity {
  id          String   @id @default(cuid())
  userId      String?
  userEmail   String
  userName    String?
  action      String   // "CREATE" | "UPDATE" | "DELETE"
  entityType  String   // "READING_TEST" | "LISTENING_TEST" | "WRITING_TASK" | "SPEAKING_SET" | "BAND_STAGE" | "MINI_QUIZ" | "VOCAB_UNIT" | "VOCAB_LESSON" | "GRAMMAR_UNIT" | "GRAMMAR_LESSON" | "BACKGROUND_MUSIC" | "SPEAKING_VOICE"
  entityId    String
  entityTitle String   @db.Text
  entityHref  String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, createdAt])
  @@index([userId, createdAt])
}

// Examiner voices the Speaking module offers learners. Admin can add/remove
// entries on /admin/voices so the catalogue isn't pinned to a hard-coded
// list. voiceId is the Deepgram Aura identifier (e.g. aura-2-aurora-en).
model SpeakingVoice {
  id        String   @id @default(cuid())
  voiceId   String   @unique
  name      String
  accent    String
  gender    String
  enabled   Boolean  @default(true)
  isDefault Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, order])
}

/// Shadowing/Dictation lesson — a YouTube video (or uploaded audio
/// later) sliced into short segments the learner repeats. `source` is
/// the channel/platform label shown on the card ("TED-Ed", "Netflix",
/// "BBC"). `youtubeId` is the 11-char video id (preferred so we can
/// embed via the IFrame Player API + thumbnail URL).
model ShadowingLesson {
  id          String   @id @default(cuid())
  title       String
  source      String
  /// CEFR difficulty so learners can pick by level. Null = chưa phân loại.
  level       CEFRLevel?
  youtubeId   String
  thumbnailUrl String? @db.Text
  /// Null = community/admin lesson. Set = user-uploaded private lesson.
  createdBy   String?
  user        User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  /// Hidden lessons stay private to creator until admin promotes.
  published   Boolean  @default(true)
  /// Premium-gated: when true, only Premium (or admin/owner) accounts can open
  /// the lesson. Free users see it locked in the list.
  premium     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  segments    ShadowingSegment[]
  attempts    ShadowingAttempt[]
  notes       ShadowingNote[]

  @@index([published, createdAt])
  @@index([createdBy])
}

/// One sentence-sized clip inside a lesson. startSec/endSec are seconds
/// (float). Order is 1-based for display. `textVi` + `ipa` are optional
/// admin-authored helpers shown on the right column of the player.
model ShadowingSegment {
  id        String   @id @default(cuid())
  lessonId  String
  lesson    ShadowingLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  order     Int
  startSec  Float
  endSec    Float
  textEn    String   @db.Text
  textVi    String?  @db.Text
  ipa       String?  @db.Text

  attempts  ShadowingAttempt[]

  @@unique([lessonId, order])
  @@index([lessonId])
}

/// Per-user free-text notes for a lesson. Surfaced in the "Ghi chú"
/// tab in the player. One row per (user, lesson) — upsert on autosave.
model ShadowingNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    ShadowingLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  text      String   @db.Text
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, lessonId])
}

/// One recorded attempt at a segment. Stores the Whisper transcript
/// and a 0-100 word-match score against textEn so the UI can show
/// progress without rerunning the model.
model ShadowingAttempt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      ShadowingLesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  segmentId   String
  segment     ShadowingSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  transcript  String?  @db.Text
  score       Float?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([segmentId])
}

/// Passive-listening podcast episode. Mirrors ShadowingLesson's YouTube +
/// transcript shape but lighter: no per-segment ShadowingAttempt rows, no
/// scoring, no notes. Users open it, watch full-screen, scroll the
/// transcript along. Transcript is inlined as JSON because the player
/// renders the entire list at once and we never query into individual
/// segments — keeping it inline saves a join + N+1 risk.
/// Tin nhắn góp ý / yêu cầu hỗ trợ từ người dùng gửi tới admin (từ landing).
/// `kind` = "feedback" (góp ý) hoặc "support" (cần hỗ trợ). `status` = "new"
/// | "read" để admin lọc tin chưa đọc. userId/email/name đều optional vì
/// khách chưa đăng nhập vẫn gửi được.
model Feedback {
  id        String   @id @default(cuid())
  kind      String   @default("feedback")
  name      String?
  email     String?
  message   String   @db.Text
  userId    String?
  status    String   @default("new")
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

// Admin-posted announcements shown in the notification bell (landing + app):
// product updates, discount codes, useful info. The bell badge = how many are
// newer than what the visitor last saw (tracked client-side in localStorage).
model Announcement {
  id        String   @id @default(cuid())
  kind      String   @default("info") // "update" | "discount" | "info"
  title     String
  body      String   @db.Text
  code      String? // optional discount code to copy
  active    Boolean  @default(true)
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([active, createdAt])
}

model PodcastEpisode {
  id           String   @id @default(cuid())
  title        String
  channel      String   // YouTube channel name, used as the badge
  /// CEFR difficulty so learners can pick by level. Null = chưa phân loại.
  level        CEFRLevel?
  youtubeId    String   @unique
  thumbnailUrl String   @db.Text
  durationSec  Int      // for the "12 min" badge on cards
  /// [{ startSec: number, endSec: number, textEn: string }]
  transcriptJson Json
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([published, createdAt])
}

/// IELTS Speaking Roulette card — fixed deck of topic prompts learners
/// "spin" through. Each card belongs to one of the 3 IELTS parts. talkPoints
/// is the bullet list shown under the question; vocab is an array of
/// {sentence, keyWord} where keyWord is the bold/clickable word in the
/// sentence. Static seed data — admin doesn't need a CRUD UI yet.
model SpeakingTopicCard {
  id          String   @id @default(cuid())
  part        Int      /// 1, 2, or 3
  topic       String   /// short label like "Art", "Family", "Travel"
  question    String   @db.Text
  talkPoints  Json     /// string[] (3 bullets)
  vocab       Json     /// { sentence: string; keyWord: string }[]
  /// Tailwind hue token for the card background (e.g. "rose", "amber").
  /// 6-8 colours cycle through the deck to give visual variety.
  hue         String   @default("amber")
  /// Display order within its part. Lower = drawn earlier in the spread.
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([part, order])
}

/// One multiplayer Speaking Roulette session. host creates → players join
/// via `code` → host starts → turn-based rounds advance via spin/submit
/// endpoints. polling-driven (no websockets) so the room state must be
/// fully serialisable per GET.
model SpeakingRouletteRoom {
  id              String   @id @default(cuid())
  /// 6-char invite code (uppercase letters + digits, no I/O/0/1 to avoid
  /// confusion). Lookup is by-code, so it's unique.
  code            String   @unique
  hostId          String
  host            User     @relation("RouletteHost", fields: [hostId], references: [id], onDelete: Cascade)
  /// Which IELTS Part the room plays (locked at create time).
  part            Int
  /// WAITING (lobby), PLAYING (turns in progress), FINISHED (leaderboard).
  status          String   @default("WAITING")
  /// Total turns the game plays before finishing. Default 5.
  totalTurns      Int      @default(5)
  /// Turn number currently in play (0 while WAITING).
  currentTurn     Int      @default(0)
  /// The card the active player is answering this turn. Null between turns.
  currentCardId   String?
  /// Index into `players` (sorted by joinedAt) whose turn it is.
  currentPlayerIdx Int     @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  players         SpeakingRoulettePlayer[]

  @@index([status, createdAt])
}

/// Membership row — one per (room, user). Score accumulates as the player
/// submits transcripts each turn.
model SpeakingRoulettePlayer {
  id        String   @id @default(cuid())
  roomId    String
  room      SpeakingRouletteRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Cumulative score across all turns this player completed.
  score     Int      @default(0)
  /// Last turn number this player has finished. Server uses this to know
  /// whose turn is next + whether the round is complete.
  lastSubmittedTurn Int @default(0)
  joinedAt  DateTime @default(now())

  @@unique([roomId, userId])
  @@index([roomId, joinedAt])
}
