generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  LEARNER
  ADMIN
}

enum CEFRLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum Skill {
  READING
  LISTENING
  WRITING
  SPEAKING
  VOCAB
  GRAMMAR
}

enum TestBank {
  PRACTICE
  MOCK
}

enum QuestionType {
  MCQ
  FILL_BLANK
  TRUE_FALSE
  TRUE_FALSE_NOT_GIVEN
  MATCHING
  MATCHING_HEADINGS
  MATCHING_INFO
  MATCHING_FEATURES
  MATCHING_SENTENCE_ENDINGS
  SHORT_ANSWER
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String?
  passwordHash       String?
  role               Role      @default(LEARNER)
  xp                 Int       @default(0)
  hearts             Int       @default(5)
  streakDays         Int       @default(0)
  lastActiveAt       DateTime?
  targetBand         Float     @default(6.0)
  examDate           DateTime?
  popQuizOn          Boolean   @default(false)
  streakRestoresUsed Int       @default(0)
  streakRestoreMonth String?
  avatarUrl          String?   @db.Text
  coverUrl           String?   @db.Text
  bio                String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  vocabProgress   VocabProgress[]
  grammarProgress GrammarProgress[]
  attempts        Attempt[]
  posts           Post[]
  postLikes       PostLike[]
  postComments    PostComment[]
  readingComments ReadingComment[]
  wordDecks       WordDeck[]
  studyPlan       StudyPlanEntry[]
}

// User-created Quizlet-style vocabulary decks.
model WordDeck {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  cards     WordCard[]
  createdAt DateTime   @default(now())

  @@index([userId])
}

model WordCard {
  id         String   @id @default(cuid())
  deckId     String
  deck       WordDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  term       String
  definition String   @db.Text
  example    String?  @db.Text
  mastered   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([deckId])
}

model Post {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String        @db.Text
  imageUrl  String?       @db.Text
  createdAt DateTime      @default(now())
  likes     PostLike[]
  comments  PostComment[]

  @@index([createdAt])
}

model PostLike {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model PostComment {
  id        String        @id @default(cuid())
  postId    String
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String        @db.Text
  createdAt DateTime      @default(now())
  parentId  String?
  parent    PostComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PostComment[] @relation("CommentReplies")

  @@index([postId])
  @@index([parentId])
}

model VocabUnit {
  id      String        @id @default(cuid())
  title   String
  level   CEFRLevel
  order   Int
  iconKey String?
  lessons VocabLesson[]

  @@unique([level, order])
}

model VocabLesson {
  id        String          @id @default(cuid())
  unitId    String
  unit      VocabUnit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title     String
  order     Int
  exercises Json
  progress  VocabProgress[]
}

model VocabProgress {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    VocabLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed Boolean     @default(false)
  score     Int?
  updatedAt DateTime    @updatedAt

  @@unique([userId, lessonId])
}

model GrammarUnit {
  id      String          @id @default(cuid())
  title   String
  level   CEFRLevel
  order   Int
  lessons GrammarLesson[]
}

model GrammarLesson {
  id        String            @id @default(cuid())
  unitId    String
  unit      GrammarUnit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title     String
  order     Int
  content   String            @db.Text
  exercises Json
  progress  GrammarProgress[]
}

model GrammarProgress {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    GrammarLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed Boolean       @default(false)
  score     Int?
  updatedAt DateTime      @updatedAt

  @@unique([userId, lessonId])
}

model ReadingTest {
  id        String           @id @default(cuid())
  title     String
  level     CEFRLevel        @default(B1)
  passage   String           @db.Text
  imageUrl  String?          @db.Text
  timeLimit Int              @default(1200)
  slot      String?
  bank      TestBank         @default(PRACTICE)
  questions Question[]
  comments  ReadingComment[]
  createdAt DateTime         @default(now())

  @@index([bank])
}

model ReadingComment {
  id        String      @id @default(cuid())
  readingId String
  reading   ReadingTest @relation(fields: [readingId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String      @db.Text
  createdAt DateTime    @default(now())

  @@index([readingId])
}

model ListeningTest {
  id         String     @id @default(cuid())
  title      String
  audioUrl   String
  imageUrl   String?    @db.Text
  transcript String?    @db.Text
  timeLimit  Int        @default(1200)
  bank       TestBank   @default(PRACTICE)
  questions  Question[]
  createdAt  DateTime   @default(now())

  @@index([bank])
}

model Question {
  id            String         @id @default(cuid())
  type          QuestionType
  prompt        String         @db.Text
  options       Json?
  correctAnswer Json
  explanation   String?        @db.Text
  order         Int            @default(0)
  // FILL_BLANK questions that share this key are one pasted form-completion
  // passage and render together as a single flowing block.
  formGroup     String?
  readingId     String?
  reading       ReadingTest?   @relation(fields: [readingId], references: [id], onDelete: Cascade)
  listeningId   String?
  listening     ListeningTest? @relation(fields: [listeningId], references: [id], onDelete: Cascade)
}

model WritingTask {
  id         String   @id @default(cuid())
  taskType   Int
  prompt     String   @db.Text
  imageUrl   String?
  diagramSvg String?  @db.Text
  minWords   Int      @default(150)
  timeLimit  Int      @default(1200)
  createdAt  DateTime @default(now())
}

model SpeakingSet {
  id             String   @id @default(cuid())
  topic          String
  imageUrl       String?  @db.Text
  part1Questions Json
  part2CueCard   Json
  part3Questions Json
  createdAt      DateTime @default(now())
}

/// User study plan entries: manual notes/milestones plus auto-generated roadmap tasks.
model StudyPlanEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  title     String
  skill     Skill?
  note      String?  @db.Text
  done      Boolean  @default(false)
  auto      Boolean  @default(false) // true = part of an auto-generated roadmap
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

model Attempt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill       Skill
  refId       String
  rawAnswer   Json
  score       Float?
  feedback    Json?
  durationSec Int?
  createdAt   DateTime @default(now())

  @@index([userId, skill])
}
