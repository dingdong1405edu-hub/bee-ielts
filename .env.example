# Database (Postgres on Railway / local)
DATABASE_URL="postgresql://user:password@localhost:5432/bee_ielts?schema=public"

# Auth.js
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# Anthropic Claude (optional now — Groq is primary grader)
ANTHROPIC_API_KEY=""

# Groq (primary AI grader + Whisper STT fallback for shadowing audio-fallback path)
GROQ_API_KEY=""

# Deepgram — speech-to-text for /api/shadowing/score AND the shadowing audio
# fallback (/api/admin/shadowing/from-youtube when a video has no EN captions).
# Falls through to Groq Whisper if unset.
DEEPGRAM_API_KEY=""

# YouTube auth bypass (OPTIONAL — only needed when YouTube's bot detection
# starts returning "login required" for videos that used to work). Three
# ways, applied if set:
#   YT_COOKIE       — full "cookie:" header value from a YouTube tab while
#                     logged in. Most reliable bypass. Copy from F12 →
#                     Network → any youtube.com request.
#   YT_VISITOR_DATA — alternative when full cookie isn't available; from
#                     X-YouTube-Visitor-Id response header.
#   YT_PO_TOKEN     — Proof of Origin Token. Pair with YT_VISITOR_DATA.
YT_COOKIE=""
YT_VISITOR_DATA=""
YT_PO_TOKEN=""

# Optional: Google OAuth
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PayOS (Vietnamese payment gateway) — get from https://my.payos.vn → Channels
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""
# Webhook URL to register on the PayOS dashboard:
#   <NEXT_PUBLIC_APP_URL>/api/payment/webhook
