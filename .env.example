# Database (Postgres on Railway / local)
DATABASE_URL="postgresql://user:password@localhost:5432/bee_ielts?schema=public"

# Auth.js
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# Anthropic Claude (optional now — Groq is primary grader)
ANTHROPIC_API_KEY=""

# Groq (primary AI grader + Whisper STT fallback for shadowing audio-fallback path)
GROQ_API_KEY=""

# Deepgram — speech-to-text for /api/shadowing/score AND the shadowing audio
# fallback (/api/admin/shadowing/from-youtube when a video has no EN captions).
# Falls through to Groq Whisper if unset.
DEEPGRAM_API_KEY=""

# YouTube auth bypass (OPTIONAL — only needed when YouTube's bot detection
# starts returning "login required" for videos that used to work). Three
# ways, applied if set:
#   YT_COOKIE       — full "cookie:" header value from a YouTube tab while
#                     logged in. Most reliable bypass. Copy from F12 →
#                     Network → any youtube.com request.
#   YT_VISITOR_DATA — alternative when full cookie isn't available; from
#                     X-YouTube-Visitor-Id response header.
#   YT_PO_TOKEN     — Proof of Origin Token. Pair with YT_VISITOR_DATA.
YT_COOKIE=""
YT_VISITOR_DATA=""
YT_PO_TOKEN=""

# Google OAuth — REQUIRED. Google is the ONLY sign-in method (no email/password).
# Create credentials at https://console.cloud.google.com → APIs & Services →
# Credentials → "OAuth client ID" (Application type: Web application).
# Add this Authorized redirect URI (use your real domain in production):
#   <NEXT_PUBLIC_APP_URL>/api/auth/callback/google
#   e.g. http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PayOS (Vietnamese payment gateway) — get from https://my.payos.vn → Channels
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""
# Webhook URL to register on the PayOS dashboard (Kênh thanh toán → Webhook):
#   <NEXT_PUBLIC_APP_URL>/api/payment/webhook
# Or register it from the CLI after deploying:
#   npm run payos:webhook -- https://beeielts.com/api/payment/webhook
#
# NOTE: NEXT_PUBLIC_APP_URL must be the REAL public URL in production — it is
# what PayOS sends the customer back to after checkout. The webhook is only a
# fast path: /pay/success also re-checks the order against the PayOS API, so a
# paid order still unlocks Premium even if the webhook never arrives.
